DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local HTTP only. Set true with HTTPS.
COOKIE_SECURE=false
DEMO_MODE=true
# Keyless symptom assistant. Requires DEMO_MODE=true; use disabled to turn it off.
ASSISTANT_MODE=demo
AI_MODE=mock
POSTGRES_DB=medicinetrack
POSTGRES_USER=medicinetrack
POSTGRES_PORT=55432
POSTGRES_PASSWORD=replace-with-a-local-database-password
# Empty DATABASE_URL uses SQLite for a quick local run. Compose supplies PostgreSQL.
DATABASE_URL=
REDIS_URL=
APP_PORT=8000
