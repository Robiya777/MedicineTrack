  </activity>
  <activity android:name=".AlarmActivity" android:exported="false" android:excludeFromRecents="true"/>
  <receiver android:name=".AlarmReceiver" android:exported="false"/>
  <service android:name=".SyncJobService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true"/>
  <receiver android:name=".ReminderReceiver" android:exported="false"/>
